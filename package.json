{
  "name": "finance-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "auth": "node --import tsx --env-file=.env scripts/auth.ts",
    "ingest": "node --import tsx --env-file=.env scripts/ingest.ts",
    "categorize:pending": "node --import tsx --env-file=.env scripts/categorize-pending.ts",
    "fix:transfers-self": "node --import tsx --env-file=.env scripts/fix-transfers-self.ts",
    "fix:investments": "node --import tsx --env-file=.env scripts/fix-investments.ts",
    "report": "node --import tsx --env-file=.env scripts/serve-report.ts",
    "start": "node --import tsx --env-file=.env src/main.ts"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "googleapis": "^171.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
